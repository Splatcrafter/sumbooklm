# Settings of a SumbookLM deployment. Copy to .env next to docker-compose.yml, or paste the same
# names into the environment variables of the Portainer stack.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------
# Both secrets are read at startup and the application refuses to start without them. Generate
# each one separately, for example with:
#   openssl rand -base64 48
SUMBOOKLM_JWT_SECRET=
SUMBOOKLM_COOKIE_SECRET=

# Password of the bundled database. Set before the first deploy: it is written into the cluster
# when the volume is created, and changing it afterwards does not change the password of the role.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------
# Image the stack runs. Leave as is to build from this repository, or point it at a tag published
# by .github/workflows/docker-publish.yml.
#SUMBOOKLM_IMAGE=ghcr.io/splatcrafter/sumbooklm:latest

# Host port the application is published on.
#SUMBOOKLM_PORT=8080

# Database name and role. Both are created when the volume is empty and read afterwards.
#POSTGRES_DB=sumbooklm
#POSTGRES_USER=sumbooklm

# Whether requests below /api are refused unless they arrived over HTTPS. Keep it on behind a
# reverse proxy that terminates TLS and sets X-Forwarded-Proto, which is what the application
# reads. Turn it off only to reach the deployment directly over plain HTTP, and know that access
# tokens travel in the clear while it is off.
#SUMBOOKLM_REQUIRE_HTTPS=true

# How the schema is kept. The application ships no migration tool, so `update` is the default and
# lets Hibernate create and extend the tables. Set it to `validate` once the schema is settled and
# you would rather have a start fail than have a column added behind your back; a schema change
# then has to be applied by hand before the new version starts.
#SUMBOOKLM_DDL_AUTO=update

# Hosts a web source may be fetched from, separated by commas. Empty permits every public host.
#SUMBOOKLM_ALLOWED_SOURCE_HOSTS=

# Options passed to the JVM. The percentage is of the memory limit of the container, so a limit is
# what actually sizes the heap. Sources are embedded in process and indexed again at every start,
# so give the container at least 2 GB.
#SUMBOOKLM_JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
